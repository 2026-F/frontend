# 백엔드(Artbid) API 베이스 URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Next.js 서버 렌더링에서 사용하는 백엔드 주소 (미설정 시 위 주소 사용)
BACKEND_ORIGIN=http://localhost:8080
# 토스페이먼츠 클라이언트 키 (개발자센터 > API 키 > "API 개별 연동 키", test_ck_로 시작)
# 백엔드 TOSS_SECRET_KEY와 같은 묶음의 키여야 승인이 된다. 결제위젯 키(test_gck_)는 쓰지 않는다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
